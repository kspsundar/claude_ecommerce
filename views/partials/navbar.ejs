            <li class="nav-item"><a class="nav-link" href="/admin">Admin</a></li>
          <% } %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"><%= currentUser.name %></a>
