          <li class="nav-item"><a class="nav-link" href="/orders">Orders</a></li>
          <% if (currentUser.role === 'seller') { %>
            <li class="nav-item"><a class="nav-link" href="/seller/dashboard">Seller</a></li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/seller/onboarding">Sell on MarketPlace</a></li>
          <% } %>
