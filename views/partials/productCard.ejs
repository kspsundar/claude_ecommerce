<div class="col-sm-6 col-md-4 col-lg-3 mb-4">
  <div class="card h-100 shadow-sm">
    <img src="<%= product.images && product.images.length ? product.images[0].imagePath : 'https://via.placeholder.com/300x220?text=No+Image' %>" class="card-img-top" style="height:200px;object-fit:cover;" alt="<%= product.title %>">
    <div class="card-body d-flex flex-column">
      <h6 class="card-title mb-1"><%= product.title %></h6>
      <p class="text-muted small mb-1"><%= product.seller ? product.seller.storeName : '' %></p>
      <p class="fw-bold mb-2">$<%= product.price.toFixed(2) %></p>
      <a href="/products/<%= product.slug %>" class="btn btn-outline-primary btn-sm mt-auto">View</a>
    </div>
  </div>
</div>
