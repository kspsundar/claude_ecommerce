<% if (success && success.length) { %>
  <div class="container flex-100">  
    <div class="container-fluid products">             
    
            <div class="custom_grids">
          <a href="https://vrikshamindia.com/collections/kundan-jadau-short-neckpiece?filter.v.availability=1&amp;filter.v.price.gte=&amp;filter.v.price.lte=&amp;sort_by=manual">
         <img class="collage_Images image_outline objfitCover" src="../images/Short_Neckpiece_1080x.webp" loading="lazy">
          </a>
         <p> Kundan Jadau Short Neckpieces </p>
     </div>
    
            <div class="custom_grids">
          <a href="https://vrikshamindia.myshopify.com/search?q=Guttapusalu&amp;options%5Bprefix%5D=last&amp;type=product&amp;id=48216205066541&amp;quantity=1">
         <img class="collage_Images image_outline objfitCover" src="../images/Guttapusalu_1080x.webp" loading="lazy">
          </a>
         <p> Guttapusalu </p>
     </div>
    
            <div class="custom_grids">
          <a href="https://vrikshamindia.com/collections/bridal-set?filter.v.availability=1&amp;filter.v.price.gte=&amp;filter.v.price.lte=&amp;sort_by=created-descending">
         <img class="collage_Images image_outline objfitCover" src="../images/IMG_0180_1080x.webp" loading="lazy">
          </a>
         <p> Bridal Sets </p>
     </div>
    </div> 
  <% success.forEach(function(msg) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= msg %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% }) %>
<% } %>
<% if (error && error.length) { %>
  <% error.forEach(function(msg) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= msg %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% }) %>
<% } %>
