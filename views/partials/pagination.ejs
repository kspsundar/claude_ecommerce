<% if (totalPages > 1) { %>
<nav aria-label="Page navigation">
  <ul class="pagination">
    <% for (let p = 1; p <= totalPages; p++) { %>
      <li class="page-item <%= p === page ? 'active' : '' %>">
        <a class="page-link" href="?<%= new URLSearchParams(Object.assign({}, query, { page: p })).toString() %>"><%= p %></a>
      </li>
    <% } %>
  </ul>
</nav>
<% } %>
