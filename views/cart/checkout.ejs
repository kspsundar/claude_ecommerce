<h1 class="h3 mb-4">Checkout</h1>

<div class="row">
  <div class="col-md-7 mb-4">
    <h2 class="h5">Order summary</h2>
    <ul class="list-group mb-3">
      <% cart.items.forEach(function(item) { %>
        <li class="list-group-item d-flex justify-content-between">
          <span><%= item.Product.title %> &times; <%= item.quantity %></span>
          <span>$<%= (item.Product.price * item.quantity).toFixed(2) %></span>
        </li>
      <% }) %>
      <li class="list-group-item d-flex justify-content-between fw-bold">
        <span>Total</span>
        <span>$<%= cart.total.toFixed(2) %></span>
      </li>
    </ul>
  </div>

  <div class="col-md-5">
    <h2 class="h5">Shipping address</h2>
    <form action="/cart/checkout" method="POST">
      <% if (!addresses.length) { %>
        <p class="text-muted small">No saved addresses. <a href="/profile">Add one</a> or continue without one.</p>
      <% } %>
      <% addresses.forEach(function(addr, idx) { %>
        <div class="form-check border rounded p-2 mb-2">
          <input class="form-check-input" type="radio" name="addressId" value="<%= addr.id %>" id="addr<%= addr.id %>" <%= (addr.isDefault || idx === 0) ? 'checked' : '' %>>
          <label class="form-check-label" for="addr<%= addr.id %>">
            <strong><%= addr.label %></strong><br>
            <span class="small text-muted"><%= addr.line1 %>, <%= addr.city %>, <%= addr.state %> <%= addr.postalCode %>, <%= addr.country %></span>
          </label>
        </div>
      <% }) %>
      <button type="submit" class="btn btn-primary w-100 mt-2">Place order</button>
    </form>
  </div>
</div>
