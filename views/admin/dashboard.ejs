<h1 class="h3 mb-4">Admin dashboard</h1>

<div class="row g-3 mb-4">
  <div class="col-md-2 col-sm-4"><div class="card text-center p-3"><div class="h4"><%= stats.userCount %></div><div class="text-muted small">Users</div></div></div>
  <div class="col-md-2 col-sm-4"><div class="card text-center p-3"><div class="h4"><%= stats.sellerCount %></div><div class="text-muted small">Approved sellers</div></div></div>
  <div class="col-md-2 col-sm-4"><div class="card text-center p-3"><div class="h4"><%= stats.pendingSellerCount %></div><div class="text-muted small">Pending sellers</div></div></div>
  <div class="col-md-2 col-sm-4"><div class="card text-center p-3"><div class="h4"><%= stats.productCount %></div><div class="text-muted small">Products</div></div></div>
  <div class="col-md-2 col-sm-4"><div class="card text-center p-3"><div class="h4"><%= stats.pendingProductCount %></div><div class="text-muted small">Pending products</div></div></div>
  <div class="col-md-2 col-sm-4"><div class="card text-center p-3"><div class="h4">$<%= stats.gmv.toFixed(2) %></div><div class="text-muted small">GMV</div></div></div>
</div>

<div class="d-flex gap-2 flex-wrap">
  <a href="/admin/users" class="btn btn-outline-secondary">Manage users</a>
  <a href="/admin/sellers" class="btn btn-outline-secondary">Manage sellers</a>
  <a href="/admin/products" class="btn btn-outline-secondary">Moderate products</a>
  <a href="/admin/categories" class="btn btn-outline-secondary">Manage categories</a>
  <a href="/admin/orders" class="btn btn-outline-secondary">View orders</a>
</div>
