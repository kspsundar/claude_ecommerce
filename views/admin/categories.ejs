<h1 class="h3 mb-4">Manage categories</h1>

<div class="row">
  <div class="col-md-7">
    <table class="table align-middle">
      <thead><tr><th>Name</th><th>Slug</th><th>Parent</th><th></th></tr></thead>
      <tbody>
        <% categories.forEach(function(c) { %>
          <tr>
            <td><%= c.name %></td>
            <td><%= c.slug %></td>
            <td><%= c.parentId ? (categories.find(x => x.id === c.parentId) || {}).name : '' %></td>
            <td>
              <form action="/admin/categories/<%= c.id %>/delete" method="POST" onsubmit="return confirm('Delete this category?')">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="col-md-5">
    <h2 class="h5">New category</h2>
    <form action="/admin/categories" method="POST">
      <div class="mb-3">
        <label class="form-label">Name</label>
        <input type="text" name="name" class="form-control" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Parent category</label>
        <select name="parentId" class="form-select">
          <option value="">-- Top level --</option>
          <% categories.forEach(function(c) { %>
            <option value="<%= c.id %>"><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <button type="submit" class="btn btn-primary">Create</button>
    </form>
  </div>
</div>
