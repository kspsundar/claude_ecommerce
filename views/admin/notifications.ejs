<h1 class="h3 mb-4">Notification log</h1>
<p class="text-muted small">Every welcome email and signup alert (email/push) the app has attempted to send, most recent first.</p>

<table class="table align-middle">
  <thead><tr><th>When</th><th>Channel</th><th>Event</th><th>Recipient</th><th>Title</th><th>Status</th></tr></thead>
  <tbody>
    <% notifications.forEach(function(n) { %>
      <tr>
        <td class="small"><%= n.createdAt.toLocaleString() %></td>
        <td><span class="badge bg-secondary"><%= n.channel %></span></td>
        <td class="small"><%= n.event %></td>
        <td class="small"><%= n.User ? `${n.User.name} <${n.User.email}>` : '—' %></td>
        <td class="small"><%= n.title || '—' %></td>
        <td>
          <span class="badge <%= n.status === 'sent' ? 'bg-success' : 'bg-danger' %>" title="<%= n.errorMessage || '' %>">
            <%= n.status %>
          </span>
        </td>
      </tr>
    <% }) %>
    <% if (!notifications.length) { %>
      <tr><td colspan="6" class="text-muted text-center py-4">No notifications sent yet.</td></tr>
    <% } %>
  </tbody>
</table>
