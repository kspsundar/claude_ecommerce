<h1 class="h3 mb-4">Orders</h1>

<table class="table align-middle">
  <thead><tr><th>Order</th><th>Buyer</th><th>Product</th><th>Qty</th><th>Price</th><th>Status</th><th>Update</th></tr></thead>
  <tbody>
    <% items.forEach(function(item) { %>
      <tr>
        <td>#<%= item.Order.id %></td>
        <td><%= item.Order.buyer ? item.Order.buyer.name : '' %></td>
        <td><%= item.Product ? item.Product.title : item.titleSnapshot %></td>
        <td><%= item.quantity %></td>
        <td>$<%= item.price.toFixed(2) %></td>
        <td><span class="badge bg-secondary"><%= item.status %></span></td>
        <td>
          <form action="/seller/orders/<%= item.id %>/status" method="POST" class="d-flex gap-1">
            <select name="status" class="form-select form-select-sm">
              <% statuses.forEach(function(s) { %>
                <option value="<%= s %>" <%= item.status === s ? 'selected' : '' %>><%= s %></option>
              <% }) %>
            </select>
            <button class="btn btn-sm btn-outline-primary" type="submit">Set</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
