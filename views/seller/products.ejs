<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">My products</h1>
  <a href="/seller/products/new" class="btn btn-primary">+ New product</a>
</div>

<table class="table align-middle">
  <thead><tr><th>Title</th><th>Price</th><th>Stock</th><th>Status</th><th></th></tr></thead>
  <tbody>
    <% products.forEach(function(p) { %>
      <tr>
        <td><%= p.title %></td>
        <td>$<%= p.price.toFixed(2) %></td>
        <td><%= p.stock %></td>
        <td><span class="badge bg-secondary"><%= p.status %></span></td>
        <td class="d-flex gap-2">
          <a href="/seller/products/<%= p.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
          <form action="/seller/products/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Delete this product?')">
            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
