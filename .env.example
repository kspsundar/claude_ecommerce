PORT=3000
SESSION_SECRET=change-this-session-secret
JWT_SECRET=change-this-jwt-secret
JWT_EXPIRES_IN=7d
DB_STORAGE=./data/database.sqlite

# --- Email (SMTP) ---
# Leave SMTP_HOST unset in dev to fall back to a console logger instead of sending real mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MarketPlace <no-reply@marketplace.local>"

# --- Web Push (VAPID) ---
# Generate with: npm run generate:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
